{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated user identity, AI assistant persona, preferred AI engine, and voice preferences.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "nickname": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "handle": {
          "type": "string",
          "maxLength": 50
        },
        "ageRange": {
          "type": "string",
          "maxLength": 30
        },
        "email": {
          "type": "string",
          "maxLength": 150
        },
        "phone": {
          "type": "string",
          "maxLength": 30
        },
        "country": {
          "type": "string",
          "maxLength": 60
        },
        "language": {
          "type": "string",
          "maxLength": 40
        },
        "plan": {
          "type": "string",
          "enum": ["Free Lite", "Pro AI Agent", "Enterprise"]
        },
        "avatar": {
          "type": "string",
          "maxLength": 1000
        },
        "style": {
          "type": "string",
          "enum": ["Concise", "Balanced", "Detailed", "Professional", "Friendly"]
        },
        "speed": {
          "type": "string",
          "enum": ["0.8x", "1.0x", "1.2x", "1.5x"]
        },
        "wakePhrase": {
          "type": "boolean"
        },
        "wakePhraseWord": {
          "type": "string",
          "maxLength": 40
        },
        "appLock": {
          "type": "boolean"
        },
        "biometric": {
          "type": "boolean"
        },
        "persona": {
          "type": "string",
          "maxLength": 120
        },
        "defaultEngine": {
          "type": "string",
          "maxLength": 80
        },
        "authProvider": {
          "type": "string",
          "maxLength": 40
        },
        "voiceName": {
          "type": "string",
          "enum": ["Zephyr", "Puck", "Charon", "Kore", "Fenrir"]
        },
        "customInstructions": {
          "type": "string",
          "maxLength": 1000
        },
        "theme": {
          "type": "string",
          "enum": ["light", "dark", "system"]
        },
        "wakeWordEnabled": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "uid",
        "name",
        "nickname",
        "email",
        "plan",
        "style",
        "speed",
        "defaultEngine",
        "createdAt",
        "updatedAt"
      ]
    },
    "CustomAgent": {
      "title": "CustomAgent",
      "description": "User-created custom AI agent template with tools, memory mode, voice persona, and system instructions.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "icon": {
          "type": "string",
          "maxLength": 40
        },
        "description": {
          "type": "string",
          "maxLength": 300
        },
        "goal": {
          "type": "string",
          "maxLength": 300
        },
        "tools": {
          "type": "array",
          "description": "Bounded list of up to 10 tool names"
        },
        "memory": {
          "type": "string",
          "maxLength": 150
        },
        "category": {
          "type": "string",
          "enum": ["Productivity", "Research", "Communication", "Lifestyle", "Developer", "Business"]
        },
        "instructions": {
          "type": "string",
          "maxLength": 1000
        },
        "voiceName": {
          "type": "string",
          "enum": ["Zephyr", "Puck", "Charon", "Kore", "Fenrir"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "name",
        "description",
        "goal",
        "tools",
        "memory",
        "category",
        "instructions",
        "createdAt",
        "updatedAt"
      ]
    },
    "UserMemory": {
      "title": "UserMemory",
      "description": "Personal long-term memory fact stored for the user's AI assistant.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "category": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "value": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "category",
        "title",
        "value",
        "createdAt",
        "updatedAt"
      ]
    },
    "Conversation": {
      "title": "Conversation",
      "description": "Private chat conversation and message thread owned exclusively by the authenticated user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "lastMessage": {
          "type": "string",
          "maxLength": 500
        },
        "updatedAtLabel": {
          "type": "string",
          "maxLength": 60
        },
        "mode": {
          "type": "string",
          "enum": ["Ask", "Act", "Research", "Create", "Offline"]
        },
        "isPinned": {
          "type": "boolean"
        },
        "isArchived": {
          "type": "boolean"
        },
        "messages": {
          "type": "array",
          "description": "Bounded list of up to 150 chat messages"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "title",
        "lastMessage",
        "updatedAtLabel",
        "mode",
        "messages",
        "createdAt",
        "updatedAt"
      ]
    },
    "Notebook": {
      "title": "Notebook",
      "description": "Private research notebook document owned by the authenticated user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "content": {
          "type": "string",
          "maxLength": 25000
        },
        "tags": {
          "type": "array",
          "description": "Bounded list of up to 10 tags"
        },
        "updatedAtLabel": {
          "type": "string",
          "maxLength": 60
        },
        "pinned": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "title",
        "description",
        "content",
        "tags",
        "updatedAtLabel",
        "createdAt",
        "updatedAt"
      ]
    },
    "Note": {
      "title": "Note",
      "description": "Private quick note and checklist owned by the authenticated user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "content": {
          "type": "string",
          "maxLength": 10000
        },
        "tags": {
          "type": "array",
          "description": "Bounded list of up to 10 tags"
        },
        "createdAtLabel": {
          "type": "string",
          "maxLength": 60
        },
        "updatedAtLabel": {
          "type": "string",
          "maxLength": 60
        },
        "isPinned": {
          "type": "boolean"
        },
        "checklist": {
          "type": "array",
          "description": "Bounded list of up to 50 checklist items"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "title",
        "content",
        "tags",
        "createdAtLabel",
        "updatedAtLabel",
        "isPinned",
        "checklist",
        "createdAt",
        "updatedAt"
      ]
    },
    "Task": {
      "title": "Task",
      "description": "Private user task item owned by the authenticated user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "dueDate": {
          "type": "string",
          "maxLength": 60
        },
        "time": {
          "type": "string",
          "maxLength": 40
        },
        "priority": {
          "type": "string",
          "enum": ["High", "Medium", "Low"]
        },
        "status": {
          "type": "string",
          "enum": ["Today", "Upcoming", "Completed"]
        },
        "aiSuggestion": {
          "type": "string",
          "maxLength": 500
        },
        "reminderSet": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "title",
        "dueDate",
        "time",
        "priority",
        "status",
        "reminderSet",
        "createdAt",
        "updatedAt"
      ]
    },
    "ActivityLog": {
      "title": "ActivityLog",
      "description": "Private audit log entry for commands executed by the authenticated user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "command": {
          "type": "string",
          "maxLength": 300
        },
        "interpretation": {
          "type": "string",
          "maxLength": 500
        },
        "actionPerformed": {
          "type": "string",
          "maxLength": 500
        },
        "serviceUsed": {
          "type": "string",
          "maxLength": 120
        },
        "dataAccessed": {
          "type": "string",
          "maxLength": 150
        },
        "permissionUsed": {
          "type": "string",
          "maxLength": 120
        },
        "result": {
          "type": "string",
          "enum": ["Success", "Failed", "Cancelled", "Pending Confirmation"]
        },
        "timestampLabel": {
          "type": "string",
          "maxLength": 60
        },
        "confirmationLevel": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "command",
        "interpretation",
        "actionPerformed",
        "serviceUsed",
        "dataAccessed",
        "permissionUsed",
        "result",
        "timestampLabel",
        "confirmationLevel",
        "createdAt",
        "updatedAt"
      ]
    },
    "LibraryDoc": {
      "title": "LibraryDoc",
      "description": "Metadata and personal study notes for an uploaded PDF, slide deck, document, or bookmark owned by the user (binary blobs stored locally in user-scoped IndexedDB).",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "folder": {
          "type": "string",
          "enum": ["Dictionary", "Books & Slides", "Notes", "Papers", "Bookmarks"]
        },
        "fileType": {
          "type": "string",
          "enum": ["PDF", "Slides", "Image", "Text", "Bookmark"]
        },
        "mimeType": {
          "type": "string",
          "maxLength": 120
        },
        "sizeBytes": {
          "type": "integer"
        },
        "sizeLabel": {
          "type": "string",
          "maxLength": 40
        },
        "url": {
          "type": "string",
          "maxLength": 600
        },
        "notes": {
          "type": "string",
          "maxLength": 15000
        },
        "localBlobId": {
          "type": "string",
          "maxLength": 128
        },
        "textPreview": {
          "type": "string",
          "maxLength": 12000
        },
        "uploadedAt": {
          "type": "string",
          "maxLength": 60
        },
        "updatedAtLabel": {
          "type": "string",
          "maxLength": 60
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "title",
        "folder",
        "fileType",
        "mimeType",
        "sizeBytes",
        "sizeLabel",
        "notes",
        "uploadedAt",
        "updatedAtLabel",
        "createdAt",
        "updatedAt"
      ]
    },
    "StudyWorkspace": {
      "title": "StudyWorkspace",
      "description": "Private Academic GPA/Syllabus/Checklist, IELTS Band/Practice/Vocab, and Coders progress workspace owned by the authenticated user.",
      "type": "object",
      "properties": {
        "ownerId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "gpaScale": {
          "type": "string",
          "enum": ["4.0", "5.0"]
        },
        "gpaCourses": {
          "type": "array",
          "description": "Bounded list of up to 80 graded courses"
        },
        "syllabusItems": {
          "type": "array",
          "description": "Bounded list of up to 80 syllabus progress trackers"
        },
        "academicChecklist": {
          "type": "array",
          "description": "Bounded list of up to 100 academic assignment/exam items"
        },
        "academicLinks": {
          "type": "array",
          "description": "Bounded list of up to 60 academic resource links"
        },
        "pomodoroMinutesTotal": {
          "type": "integer"
        },
        "ieltsTargetBand": {
          "type": "number"
        },
        "ieltsScores": {
          "type": "object"
        },
        "ieltsPracticeLogs": {
          "type": "array",
          "description": "Bounded list of up to 120 IELTS practice entries"
        },
        "ieltsVocabNotes": {
          "type": "array",
          "description": "Bounded list of up to 150 vocabulary & cue card entries"
        },
        "ieltsChecklist": {
          "type": "array",
          "description": "Bounded list of up to 100 IELTS preparation checklist items"
        },
        "codersBookmarkedIds": {
          "type": "array",
          "description": "Bounded list of up to 100 bookmarked coder resources"
        },
        "codersCompletedIds": {
          "type": "array",
          "description": "Bounded list of up to 100 completed coder resources"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "ownerId",
        "gpaScale",
        "gpaCourses",
        "syllabusItems",
        "academicChecklist",
        "academicLinks",
        "pomodoroMinutesTotal",
        "ieltsTargetBand",
        "ieltsScores",
        "ieltsPracticeLogs",
        "ieltsVocabNotes",
        "ieltsChecklist",
        "codersBookmarkedIds",
        "codersCompletedIds",
        "createdAt",
        "updatedAt"
      ]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private user profile and assistant preferences document owned by userId."
    },
    "/users/{userId}/agents/{agentId}": {
      "schema": { "$ref": "#/entities/CustomAgent" },
      "description": "Custom AI agents created by userId."
    },
    "/users/{userId}/memories/{memoryId}": {
      "schema": { "$ref": "#/entities/UserMemory" },
      "description": "Personal memory facts owned by userId."
    },
    "/users/{userId}/conversations/{conversationId}": {
      "schema": { "$ref": "#/entities/Conversation" },
      "description": "Private chat conversations owned by userId."
    },
    "/users/{userId}/notebooks/{notebookId}": {
      "schema": { "$ref": "#/entities/Notebook" },
      "description": "Private notebooks owned by userId."
    },
    "/users/{userId}/notes/{noteId}": {
      "schema": { "$ref": "#/entities/Note" },
      "description": "Private quick notes owned by userId."
    },
    "/users/{userId}/tasks/{taskId}": {
      "schema": { "$ref": "#/entities/Task" },
      "description": "Private user tasks owned by userId."
    },
    "/users/{userId}/activityLogs/{logId}": {
      "schema": { "$ref": "#/entities/ActivityLog" },
      "description": "Private command activity audit logs owned by userId."
    },
    "/users/{userId}/libraryDocs/{docId}": {
      "schema": { "$ref": "#/entities/LibraryDoc" },
      "description": "Private study library documents and bookmarks owned by userId."
    },
    "/users/{userId}/studyWorkspaces/{workspaceId}": {
      "schema": { "$ref": "#/entities/StudyWorkspace" },
      "description": "Private Study Table (Academic & IELTS) and Coders progress owned by userId."
    }
  }
}
